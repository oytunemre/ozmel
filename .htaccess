# QFW Program — sunucu ayarları (Plesk / Apache)

# config.php veritabanı şifresini içerir. PHP olarak çalıştığı için normalde
# içeriği dışarı sızmaz, ama PHP bir şekilde devre dışı kalırsa düz metin
# olarak servis edilirdi. Bu yüzden dışarıdan erişimi tamamen kapatıyoruz.
# (Diğer .php dosyaları config.php'yi dosya sisteminden okur, bu kural onları etkilemez.)
<FilesMatch "^(config\.php|schema\.sql|DEPLOY\.md)$">
  Require all denied
</FilesMatch>

# Dizin listelemeyi kapat
Options -Indexes

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# index.html tarayıcıda önbelleğe alınırsa güncellemeler görünmez.
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
